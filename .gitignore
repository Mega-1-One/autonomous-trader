# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.coverage
htmlcov/

# Virtual environments (any level, covers backend/venv/)
venv/
env/
ENV/
.venv/
**/venv/
**/.venv/

# Environment variables and credentials (allow examples)
.env
.env.*
*.pem
*.key
!.env.example

# Databases (local sqlite - don't commit local state)
*.db
*.sqlite3
*.sqlite3-journal

# Node / Next.js frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
node_modules/
.next/
out/
dist/

# TypeScript / Next build info
*.tsbuildinfo
frontend/*.tsbuildinfo

# NPM / Yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes / local data
postgres_data/
data/postgres/
*.log

# Cross-process runtime state (emergency-stop sentinel, ADR-8)
backend/state/

# System and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# OneDrive / Office temp files
~$*
*.tmp
*.temp

# Environment Configuration Template

# Execution Mode Safety Flags
EXECUTION_MODE=PAPER  # Choices: BACKTEST, PAPER, DEMO, LIVE
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=false

# Application Config
APP_NAME="Autonomous Trader"
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32bytes

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=traderpass
POSTGRES_DB=autotrader_db
DATABASE_URL=postgresql+asyncpg://trader:traderpass@localhost:5432/autotrader_db

# MT5 Account Configuration (Required when EXECUTION_MODE=LIVE or DEMO)
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# API Ports
PORT=8000
FRONTEND_PORT=3000

# CORS origins for the dashboard (comma-separated; wildcard is not allowed, C-06)
CORS_ORIGINS=http://localhost:3000

# Optional bearer token: when APP_ENV=production AND this is set, mutating API
# endpoints require `Authorization: Bearer <token>` (D-01). The bundled
# dashboard sends it via NEXT_PUBLIC_API_TOKEN (see frontend/lib/api.ts).
# AUTOMATION_API_TOKEN=

# Cross-process state directory (emergency-stop sentinel file lives here; gitignored).
# Leave commented to use the default <repo>/backend/state
# AUTOTRADER_STATE_DIR=
